// content/maps/sol/gen_rules.ron — rules for seeded hypothetical bodies (WS-08b §4.1, WLD-053–055).
// All draws use worldgen_stream(seed, "<class id>#<k>", purpose), so adding a class never changes another class's bodies.
// Count ~ Poisson(count_mean) truncated at max; the maxes sum to 16, so the world holds at most 28 + 16 = 44 bodies.
// Every generated body starts undiscovered by every polity (WLD-057). Values are [D] unless tagged.
GenRules(
    classes: [
        // Near-Earth asteroids: q = a(1−e) ≤ 1.3 AU is the NEO definition [R: CNEOS]; Q ≤ 4.2 AU keeps them off Jupiter's orbit.
        GenClass(id: "gen.nea", max: 7, parent: "body.sun", count_mean: 5.0, class: Asteroid,
                 a_au: (0.8, 2.5), q_max_au: Some(1.3), apo_max_au: Some(4.2), inc_rayleigh_deg: 8.0,
                 diameter_km: (0.5, 5.0), size_slope: 2.3,                      // N(>D) ∝ D^-slope [R]
                 composition: [(Stony, 0.55), (Carbonaceous, 0.35), (Metallic, 0.10)]),
        // Main-belt bodies small enough to be undiscovered in 1955; Kirkwood gaps excluded.
        GenClass(id: "gen.belt", max: 4, parent: "body.sun", count_mean: 3.0, class: Asteroid,
                 a_au: (2.1, 3.3), gaps_au: [(2.50, 0.03), (2.82, 0.03), (2.95, 0.02)],   // 3:1, 5:2, 7:3 resonances [R]
                 inc_rayleigh_deg: 7.0, diameter_km: (10.0, 60.0), size_slope: 2.0,
                 composition: [(Carbonaceous, 0.5), (Stony, 0.35), (Metallic, 0.15)]),
        // Irregular moons of the giant planets: 0.10–0.40 of the parent's Hill radius, ≥ 10% apart in a from any other moon.
        GenClass(id: "gen.irregular_jupiter", max: 2, parent: "body.jupiter", count_mean: 1.0, class: Moon,
                 hill_fraction: (0.10, 0.40), min_rel_spacing: 0.10, inc_rayleigh_deg: 30.0,
                 diameter_km: (5.0, 50.0), size_slope: 2.0, composition: [(Carbonaceous, 0.8), (Icy, 0.2)]),
        GenClass(id: "gen.irregular_saturn", max: 2, parent: "body.saturn", count_mean: 1.0, class: Moon,
                 hill_fraction: (0.10, 0.40), min_rel_spacing: 0.10, inc_rayleigh_deg: 30.0,
                 diameter_km: (5.0, 50.0), size_slope: 2.0, composition: [(Carbonaceous, 0.6), (Icy, 0.4)]),
        // Small inner moonlets of Mars: outside 1.5 × the fluid Roche limit, inside 0.3 r_Hill, ≥ 10% apart from Phobos and Deimos.
        GenClass(id: "gen.moonlet_mars", max: 1, parent: "body.mars", count_mean: 0.3, class: Moon,
                 roche_factor: 1.5, hill_fraction: (0.0, 0.30), min_rel_spacing: 0.10, inc_rayleigh_deg: 2.0,
                 diameter_km: (0.5, 3.0), size_slope: 2.5, composition: [(Carbonaceous, 1.0)]),
    ],
    densities_g_cm3: [(Stony, 2.7), (Carbonaceous, 1.7), (Metallic, 5.0), (Icy, 1.2), (Rocky, 3.0)],   // [R] typical bulk densities
)
