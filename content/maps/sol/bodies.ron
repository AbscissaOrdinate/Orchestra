// content/maps/sol/bodies.ron — Solar System template bodies and their nodes (WS-08b §3.1, WLD-050/051).
// Real physical data only; no polity IDs (ARC-052). Hypothetical bodies are generated at worldgen from gen_rules.ron.
// Sources (WS-08b §8):
//   [JPL-AP]  JPL SSD, Approximate Positions of the Planets, Table 1 (1800–2050): a, I, L, L-rate (deg/century)
//   [JPL-PP]  JPL SSD, Planetary Physical Parameters: equatorial radius, mass (GM = mass × G, CODATA 2018)
//   [JPL-SP]  JPL SSD, Planetary Satellite Physical Parameters: GM, mean radius (and planet GM table)
//   [JPL-SE]  JPL SSD, Planetary Satellite Mean Elements: a, i
//   [NSSDC-A] NASA NSSDC Asteroid Fact Sheet: a, i, mass, dimensions;  [IMCCE] Psyche a, i;  [PDS-E] Eros elements, mass
//   [R] recalled/secondary, not checked against a primary source;  [D] design choice
// Units: gm km^3/s^2; radius_km, alt_km km; a: Au(..) heliocentric or Km(..) planetocentric; angles deg.
// mean_lon: Some((L0 at J2000, rate deg/century)); None = phase sampled at worldgen (WS-08b §4.1 G-2).
// Every body here is canonical: present in every world with these values. discovered: Some(year) after the scenario start
// means the body exists but starts unknown, like a generated body (WS-08b §4.1 G-5); default None = known.
// Node alt_km is altitude above radius_km; High nodes are ellipses (alt_km = periapsis, apo_alt_km = apoapsis).
[
    Body(id: "body.sun", name: "Sun", parent: None, class: Star, gm: 1.32712440018e11, radius_km: 695700.0,   // [R] IAU/DE GM_sun
         orbit: None, composition: Gas, atmosphere: Thick, nodes: []),

    // ── Inner planets ─────────────────────────────────────────────────────────
    Body(id: "body.mercury", name: "Mercury", parent: Some("body.sun"), class: Planet, gm: 22032.06, radius_km: 2440.53,   // [JPL-PP]
         orbit: Some(Orbit(a: Au(0.38709927), inc_deg: 7.00497902, mean_lon: Some((252.25032350, 149472.67411175)))),   // [JPL-AP]
         composition: Rocky, atmosphere: Airless,
         nodes: [Node(regime: Surface), Node(regime: Low, alt_km: 200.0, hub: true)]),
    Body(id: "body.venus", name: "Venus", parent: Some("body.sun"), class: Planet, gm: 324858.87, radius_km: 6051.8,     // [JPL-PP]
         orbit: Some(Orbit(a: Au(0.72333566), inc_deg: 3.39467605, mean_lon: Some((181.97909950, 58517.81538729)))),    // [JPL-AP]
         composition: Rocky, atmosphere: Thick, aerocapture: true,
         nodes: [Node(regime: Low, alt_km: 300.0, hub: true)]),   // no surface node in MVP (WS-08b D1)
    Body(id: "body.earth", name: "Earth", parent: Some("body.sun"), class: Planet, gm: 398600.436, radius_km: 6378.1366, // [JPL-SP], [JPL-PP]
         orbit: Some(Orbit(a: Au(1.00000261), inc_deg: 0.0, mean_lon: Some((100.46457166, 35999.37244981)))),          // [JPL-AP] EM barycentre
         composition: Rocky, atmosphere: Thick, aerocapture: true, homeworld: true,
         nodes: [
             Node(regime: Surface, ascent_dv: Some(9.4), descent_dv: Some(0.1)),   // [R] Wikipedia "Delta-v budget"; descent [D] deorbit burn
             Node(regime: Low, alt_km: 300.0, hub: true),
             Node(regime: Medium, alt_km: 20200.0),                                 // [R] GPS altitude
             Node(regime: Synchronous, alt_km: 35786.0),                            // [V: computed from GM and sidereal day]
             Node(regime: High, alt_km: 300.0, apo_alt_km: Some(39700.0)),          // [R] Molniya apogee; perigee simplified to LEO [D]
             Node(regime: Lagrange, label: Some("eml1")),                           // edges in transfers.ron
         ]),
    Body(id: "body.moon", name: "Moon", parent: Some("body.earth"), class: Moon, gm: 4902.800, radius_km: 1737.4,     // [JPL-SP]
         orbit: Some(Orbit(a: Km(384400.0), inc_deg: 5.16, mean_lon: None)),                                          // [JPL-SE]
         composition: Rocky, atmosphere: Airless,
         nodes: [Node(regime: Surface), Node(regime: Low, alt_km: 100.0, hub: true)]),
    Body(id: "body.mars", name: "Mars", parent: Some("body.sun"), class: Planet, gm: 42828.37362, radius_km: 3396.19,  // [JPL-SP], [JPL-PP]
         orbit: Some(Orbit(a: Au(1.52371034), inc_deg: 1.84969142, mean_lon: Some((-4.55343205, 19140.30268499)))),    // [JPL-AP]
         composition: Rocky, atmosphere: Thin, aerocapture: true,
         nodes: [
             Node(regime: Surface, ascent_dv: Some(4.1), descent_dv: Some(0.7)),   // [R] Wikipedia "Delta-v budget"; descent with aero entry [R]
             Node(regime: Low, alt_km: 300.0, hub: true),
         ]),
    Body(id: "body.phobos", name: "Phobos", parent: Some("body.mars"), class: Moon, gm: 0.0007087, radius_km: 11.08,   // [JPL-SP]
         orbit: Some(Orbit(a: Km(9375.0), inc_deg: 1.1, mean_lon: None)),                                              // [JPL-SE]
         composition: Carbonaceous, atmosphere: Airless,
         nodes: [Node(regime: Surface, hub: true)]),
    Body(id: "body.deimos", name: "Deimos", parent: Some("body.mars"), class: Moon, gm: 0.0000962, radius_km: 6.2,     // [JPL-SP]
         orbit: Some(Orbit(a: Km(23457.0), inc_deg: 1.8, mean_lon: None)),                                             // [JPL-SE]
         composition: Carbonaceous, atmosphere: Airless,
         nodes: [Node(regime: Surface, hub: true)]),

    // ── Asteroids (phases sampled per world; a, i real) ───────────────────────
    Body(id: "body.ceres", name: "Ceres", parent: Some("body.sun"), class: DwarfPlanet, gm: 62.63, radius_km: 469.7,   // [JPL-PP] mass 938.416e18 kg
         orbit: Some(Orbit(a: Au(2.768), inc_deg: 10.59, mean_lon: None)),                                             // [NSSDC-A]
         composition: Carbonaceous, atmosphere: Airless,
         nodes: [Node(regime: Surface), Node(regime: Low, alt_km: 200.0, hub: true)]),
    Body(id: "body.pallas", name: "Pallas", parent: Some("body.sun"), class: Asteroid, gm: 13.68, radius_km: 273.0,    // [NSSDC-A] 205,000e15 kg; mean of axes
         orbit: Some(Orbit(a: Au(2.772), inc_deg: 34.84, mean_lon: None)),                                             // [NSSDC-A]
         composition: Carbonaceous, atmosphere: Airless,
         nodes: [Node(regime: Surface, hub: true)]),
    Body(id: "body.vesta", name: "Vesta", parent: Some("body.sun"), class: Asteroid, gm: 17.29, radius_km: 263.0,     // [NSSDC-A] 259,000e15 kg; mean of axes
         orbit: Some(Orbit(a: Au(2.362), inc_deg: 7.14, mean_lon: None)),                                              // [NSSDC-A]
         composition: Stony, atmosphere: Airless,
         nodes: [Node(regime: Surface), Node(regime: Low, alt_km: 200.0, hub: true)]),
    Body(id: "body.psyche", name: "Psyche", parent: Some("body.sun"), class: Asteroid, gm: 1.53, radius_km: 111.5,    // [R] mass ~2.3e19 kg; D 223 km (secondary)
         orbit: Some(Orbit(a: Au(2.9235), inc_deg: 3.1, mean_lon: None)),                                              // [IMCCE]
         composition: Metallic, atmosphere: Airless,
         nodes: [Node(regime: Surface, hub: true)]),
    Body(id: "body.eros", name: "Eros", parent: Some("body.sun"), class: Asteroid, gm: 0.000446, radius_km: 8.4,      // [PDS-E] mass 6.687e15 kg; D 16.8 km [R]
         orbit: Some(Orbit(a: Au(1.4579), inc_deg: 10.828, mean_lon: None)),                                           // [PDS-E]
         composition: Stony, atmosphere: Airless,
         nodes: [Node(regime: Surface, hub: true)]),

    Body(id: "body.juno", name: "Juno", parent: Some("body.sun"), class: Asteroid, gm: 1.335, radius_km: 117.0,    // [NSSDC-A] 20,000e15 kg; D 234 km
         orbit: Some(Orbit(a: Au(2.670), inc_deg: 12.99, mean_lon: None)),                                             // [NSSDC-A]
         composition: Stony, atmosphere: Airless,
         nodes: [Node(regime: Surface, hub: true)]),
    Body(id: "body.hygiea", name: "Hygiea", parent: Some("body.sun"), class: Asteroid, gm: 5.83, radius_km: 215.0,   // [R] mass ~8.7e19 kg; radius 215 km (secondary)
         orbit: Some(Orbit(a: Au(3.14), inc_deg: 3.8, mean_lon: None)),                                                // [R] secondary
         composition: Carbonaceous, atmosphere: Airless,
         nodes: [Node(regime: Surface, hub: true)]),
    // Moons of the giant planets: GM, radius [JPL-SP]; a, i [JPL-SE]. Planet a, I, L [JPL-AP]; radius [JPL-PP]; GM [JPL-SP].
    // ── Giant planets: hub is an elliptical capture orbit (periapsis 1.5 R, apoapsis 100 R) [D] ──
    Body(id: "body.jupiter", name: "Jupiter", parent: Some("body.sun"), class: Planet, gm: 126686531.9, radius_km: 71492.0,  // [JPL-SP], [JPL-PP]
