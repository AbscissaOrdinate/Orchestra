    // ── Pluto system (canonical; no edge within the 240-month cap until gravity assists exist, so isolated in the MVP) ──
    Body(id: "body.pluto", name: "Pluto", parent: Some("body.sun"), class: DwarfPlanet, gm: 869.3, radius_km: 1188.3,   // [JPL-PP] mass 13024.6e18 kg
