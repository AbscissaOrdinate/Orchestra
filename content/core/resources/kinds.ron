// content/core/resources/kinds.ron — resource taxonomy (WS-08b §4.4, WLD-075). Keep it small: every kind names its mechanics.
// Mechanics: Rent (WS-03 extraction rent, §4.6) · CommodityFactor (price loads on WS-03 f_g, §4.5) ·
//            NuclearFeed (fissile self-sufficiency index to WS-05/WS-11) · Propellant (in-space ISRU, §4.9).
// Prices are 1955 world prices in reference currency (RC = WS-03 world unit at 1955 PPP), billions per unit.
// Values are [D] calibration starting points unless tagged; the M2(d) prototype tunes them (prototypes/ws08b-sol/README.md).
[
    ResourceKind(id: "res.hydrocarbons", name: "Hydrocarbons", unit: "Gboe",           // billion barrels of oil equivalent
        mechanics: [Rent, CommodityFactor], on_earth: true, off_earth: false,
        price_ref: 1.9,            // [R] ≈ US$1.9/bbl posted Gulf crude, mid-1950s
        cost_ref: 0.6,             // unit cost at difficulty 1.0 (onshore, conventional) [D]
        fg_loading: 1.0,           // η: d ln p / d f_g
        demand_elasticity: 0.25,   // ε in the scarcity term [R: short-run oil demand is inelastic]
        intensity_decline: 0.010,  // per-year fall in demand per unit of world GDP; demand otherwise scales with world GDP (§4.5) [D]
        extraction_rate: 0.02,     // max annual production / remaining ultimate reserve; ≈ 7 Gboe/yr from the known 1955 tags vs ≈ 5.6 real [R]
        dev_months: 36, capex_months: 24),   // development lag; capex = capex_months × full monthly output value at price_ref
    ResourceKind(id: "res.metals", name: "Metals", unit: "Mt-eq",                    // million tonnes of copper-equivalent value
        mechanics: [Rent, CommodityFactor], on_earth: true, off_earth: true,
        price_ref: 0.95,           // [R] copper ≈ US$0.43/lb in 1955
        cost_ref: 0.6, fg_loading: 0.6, demand_elasticity: 0.4, intensity_decline: 0.008,
        extraction_rate: 0.025, dev_months: 48, capex_months: 30),
    ResourceKind(id: "res.fissile", name: "Fissile ores", unit: "kt U",
        mechanics: [Rent, NuclearFeed], on_earth: true, off_earth: true,
        price_ref: 0.02,           // [R] ≈ US$8–10/lb U3O8 government purchase price, 1950s
        cost_ref: 0.012, fg_loading: 0.2, demand_elasticity: 0.3, intensity_decline: 0.0,
        extraction_rate: 0.03, dev_months: 36, capex_months: 24),
    ResourceKind(id: "res.volatiles", name: "Volatiles (water ice)", unit: "Mt",
        mechanics: [Propellant], on_earth: false, off_earth: true,
        price_ref: 0.0, cost_ref: 0.0, fg_loading: 0.0, demand_elasticity: 0.0, intensity_decline: 0.0,
        extraction_rate: 0.0, dev_months: 0, capex_months: 0),   // valued in space only, by avoided launch mass (§4.9)
]
