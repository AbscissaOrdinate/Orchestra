// content/core/resources/surveys.ron — prospecting survey types (WS-08b §4.8, WLD-090/091).
// Each completed survey pushes one Observation per covered subject with noise sigma on the belief's scale (ADR-0008).
// sigma_size: on ln S (Log scale). sigma_cost: on ln(δ/g) (off-Earth only). cost: RC billions at 1955 prices [D].
// p_discover: chance that a covered deposit nobody knows of (belief None) is discovered by this survey.
[
    Survey(id: "survey.geological", target: Region, requires: [], months: 12, cost: 0.02,
           sigma_size: 0.8, sigma_cost: None, p_discover: 0.5, note: "aerial and seismic reconnaissance"),
    Survey(id: "survey.drilling", target: Deposit, requires: [], months: 12, cost: 0.10,
           sigma_size: 0.3, sigma_cost: None, p_discover: 0.0, note: "appraisal wells or cores on a known prospect"),
    Survey(id: "survey.telescopic", target: Sky, requires: ["cap.observatory"], months: 12, cost: 0.01,
           sigma_size: 1.5, sigma_cost: None, p_discover: 0.0, note: "finds hypothetical bodies (WS-08b §4.8); composition class only"),
    Survey(id: "survey.orbital", target: Body, requires: ["cap.orbital_spectrometry"], months: 6, cost: 0.0,
           sigma_size: 0.9, sigma_cost: Some(0.8), p_discover: 0.8, note: "spacecraft at the body's hub node; cost is the mission"),
    Survey(id: "survey.in_situ", target: Deposit, requires: ["cap.lander"], months: 3, cost: 0.0,
           sigma_size: 0.4, sigma_cost: Some(0.3), p_discover: 0.0, note: "lander or rover at the Surface node"),
    Survey(id: "survey.sample", target: Deposit, requires: [], months: 6, cost: 0.0,
           sigma_size: 0.15, sigma_cost: Some(0.1), p_discover: 0.0, note: "outpost drilling or returned sample"),
]
